# Copia a .env y rellena. El .env real JAMAS se commitea (esta en .gitignore).
#
# Nada de esto hace falta para 'docker compose up': compose trae valores por defecto de
# desarrollo local, asi que un clon limpio arranca sin tocar nada. Este fichero es para
# cambiar esos valores y para las variables que todavia no tienen consumidor.
# Las variables van sin valor a proposito (regla del repo).

# --- Base de datos y cola (encargo 0.3) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Desde DENTRO de compose la api usa db:5432. Esta de aqui es para procesos del HOST
# (la ingesta de la fase 1 corre en Windows con la GPU): puerto 5434.
#   postgresql://usuario:clave@127.0.0.1:5434/veridica
DATABASE_URL=
# Redis no publica puerto al host a proposito: solo se alcanza desde la red de compose.
REDIS_URL=

# --- Inferencia (fase 2: todavia no hay cliente que las lea) ---
INFERENCIA_BASE_URL=
INFERENCIA_API_KEY=
MODELO_PEQUENO=
MODELO_GRANDE=

# --- Precios, para la contabilidad de coste (fase 6) ---
PRECIO_ENTRADA_PEQ=
PRECIO_SALIDA_PEQ=
PRECIO_ENTRADA_GRANDE=
PRECIO_SALIDA_GRANDE=

# --- Umbrales iniciales, que se calibran donde la guia lo indica (fases 3, 4 y 6) ---
UMBRAL_CACHE_SIM=
UMBRAL_NLI=
RERANK_CANDIDATOS=
TIMEOUT_ETAPA_MS=
PRESUPUESTO_CONSULTA_MS=

# --- Versionado, que va en cada traza (fases 1 y 4) ---
VERSION_PROMPT=
VERSION_CORPUS=
