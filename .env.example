# Copia a .env y rellena. El .env real JAMAS se commitea (esta en .gitignore).
#
# Nada de esto hace falta para 'docker compose up': compose trae valores por defecto de
# desarrollo local, asi que un clon limpio arranca sin tocar nada. Este fichero es para
# cambiar esos valores y para las variables que todavia no tienen consumidor.
# Las variables van sin valor a proposito (regla del repo).

# --- Base de datos y cola (encargo 0.3) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Desde DENTRO de compose la api usa db:5432. Esta de aqui es para procesos del HOST
# (la ingesta de la fase 1 corre en Windows con la GPU): puerto 5434.
#   postgresql://usuario:clave@127.0.0.1:5434/veridica
DATABASE_URL=
# Redis no publica puerto al host a proposito: solo se alcanza desde la red de compose.
REDIS_URL=

# --- Inferencia (fase 2: todavia no hay cliente que las lea) ---
INFERENCIA_BASE_URL=
INFERENCIA_API_KEY=
MODELO_PEQUENO=
MODELO_GRANDE=

# --- Precios, para la contabilidad de coste (fase 6) ---
PRECIO_ENTRADA_PEQ=
PRECIO_SALIDA_PEQ=
PRECIO_ENTRADA_GRANDE=
PRECIO_SALIDA_GRANDE=

# --- Umbrales iniciales, que se calibran donde la guia lo indica (fases 3, 4 y 6) ---
UMBRAL_CACHE_SIM=
UMBRAL_NLI=
RERANK_CANDIDATOS=
TIMEOUT_ETAPA_MS=
# Hueco maximo ENTRE TROZOS del flujo del proveedor. Aparte del de etapa a proposito: aquel acota
# una fase entera y este el caso "no llega nada", que es el unico que ningun vigilante de dentro
# del bucle puede ver. En blanco = 5000 ms.
TIMEOUT_LECTURA_MS=
# Objetivo de producto y plazo operativo. Son DOS cosas y se reportan juntas: una respuesta de
# 6,2 s se entrega y aun asi incumple el objetivo. REVISADO EL 14/08/2026 con la medida delante
# (p50 3.893 ms de la configuracion completa): el objetivo sigue en 5000 y el plazo donde se corta
# sube a 8000 -con 5000 se tiraban el 30 % de las respuestas ya pagadas-. Llevan el valor escrito
# -no vacio- porque no son secretos y porque un requisito que hay que ir a buscar a otro fichero
# se incumple sin que nadie se entere. (Este fichero llego a tener DOS asignaciones de
# PRESUPUESTO_CONSULTA_MS y en dotenv gana la ultima, que decia 5000: cazado por la pasada
# adversarial del 14/08.)
OBJETIVO_CONSULTA_MS=5000
PRESUPUESTO_CONSULTA_MS=8000

# --- Reordenador (3.4): DESCARTADO por su propio criterio el 14/08/2026 (ADR 0019) ---
# Por defecto NO se carga: reordenar midio PEOR que la fusion sin reordenar (56,0 % contra 58,7 %
# de recall@6 en lectura). Ponlo a 1 SOLO para ablacion o re-medida; entonces rige el ADR 0015
# (GPU o nada, y degradacion anunciada si no contesta).
REORDENADOR_ACTIVO=0

# --- Versionado, que va en cada traza (fases 1 y 4) ---
VERSION_PROMPT=
VERSION_CORPUS=
